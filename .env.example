# Databuddy website id, safe to expose, used by the analytics script
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Databuddy API key with the read:data scope, server only, powers the pageview
DATABUDDY_API_KEY=

# Databuddy API key with the track:events scope, server only, records cli installs
DATABUDDY_TRACK_API_KEY=

# github token for the iKislay account (classic PAT with read:user), server only, lists pixel ui sponsors on the landing page
GITHUB_SPONSORS_TOKEN=
