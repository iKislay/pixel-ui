# Databuddy website id, safe to expose, used by the analytics script
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Databuddy API key with the read:data scope, server only, powers the pageview
DATABUDDY_API_KEY=

# Databuddy API key with the track:events scope, server only, records cli installs
DATABUDDY_TRACK_API_KEY=

# github token for the iKislay account (classic PAT with read:user), server only, lists pixel ui sponsors on the landing page
GITHUB_SPONSORS_TOKEN=

# polar organization access token with license_keys:write and checkouts:write, server only, checks pro keys and opens checkout
POLAR_ACCESS_TOKEN=

# polar organization id, server only, pro keys are only accepted from this organization
POLAR_ORGANIZATION_ID=

# id of the license keys benefit on the pro product, server only, keys from other products are refused
POLAR_PRO_BENEFIT_ID=

# optional: https://sandbox-api.polar.sh and a sandbox product id, for testing checkout without real money
POLAR_API_URL=
POLAR_PRO_PRODUCT_ID=

# private repo holding the built pro registry in public/r, as owner/name
PRO_REGISTRY_REPO=

# fine-grained github token with read-only contents access to PRO_REGISTRY_REPO only, server only
PRO_GITHUB_TOKEN=

# polar organization slug, server only, links buyers to polar.sh/<slug>/portal where their key lives
POLAR_ORGANIZATION_SLUG=
