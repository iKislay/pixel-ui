{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pixel-ui",
  "homepage": "https://github.com/ikislay/pixel-ui",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper for merging Tailwind classes.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "toast",
      "type": "registry:ui",
      "title": "Toast",
      "description": "A toast notification whose status lands with a rippling pulse and whose text morphs word by word.",
      "dependencies": [
        "motion",
        "lucide-react"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "components/ui/toast.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "audio-chat-room",
      "type": "registry:ui",
      "title": "Audio Chat Room",
      "description": "A voice chat pill that morphs into a card showing everyone in the room.",
      "css": {
        "@keyframes voice-bar": {
          "0%, 100%": {
            "transform": "scaleY(0.43)"
          },
          "50%": {
            "transform": "scaleY(1)"
          }
        }
      },
      "files": [
        {
          "path": "components/ui/audio-chat-room.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "member-selector",
      "type": "registry:ui",
      "title": "Member Selector",
      "description": "An avatar row for picking people, with a searchable dropdown to add more.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "components/ui/member-selector.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
